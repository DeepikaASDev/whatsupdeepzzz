# Copy this file to .env and fill in your key. Never commit .env.

# Model as "provider:model-name" (any model LangChain's init_chat_model supports).
# Check your provider's docs for current model names.
# Free option: Google Gemini (no card needed). Get a key at https://aistudio.google.com/apikey
LLM_MODEL=google_genai:gemini-2.5-flash
GOOGLE_API_KEY=

# Free option with NO key or account: a local model via Ollama (https://ollama.com).
# Install Ollama, run:  ollama pull llama3.2   then use:
# LLM_MODEL=ollama:llama3.2

# Free option 2: Groq (sign up with just an email). Get a key at https://console.groq.com/keys
# If this model is retired, pick another model that supports tool use from console.groq.com/docs/models
# LLM_MODEL=groq:llama-3.3-70b-versatile
# GROQ_API_KEY=

# To use OpenAI instead (needs prepaid API credit):
# LLM_MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=

# To use Anthropic Claude instead:
# LLM_MODEL=anthropic:<claude-model-name>
# ANTHROPIC_API_KEY=

DB_PATH=data/appointments.db
CLINIC_TIMEZONE=America/Los_Angeles
MAX_MESSAGE_CHARS=1000
