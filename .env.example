# Copy this file to .env and fill it in. Never commit .env.

# Your name, so Deepzzzz knows what to call you.
USER_NAME=Deepika

# Model as "provider:model-name". Default: Groq (free, fast). Get a key at https://console.groq.com/keys
# If a model is retired, pick another one that supports tool use from console.groq.com/docs/models
LLM_MODEL=groq:llama-3.3-70b-versatile
GROQ_API_KEY=

# Free with no key: a local model via Ollama (https://ollama.com). Run: ollama pull llama3.2
# LLM_MODEL=ollama:llama3.2

# Google Gemini (free tier):  LLM_MODEL=google_genai:gemini-2.5-flash   GOOGLE_API_KEY=
# OpenAI (paid):               LLM_MODEL=openai:gpt-4o-mini              OPENAI_API_KEY=

DATA_DIR=data
TIMEZONE=America/Los_Angeles
MAX_MESSAGE_CHARS=4000
HISTORY_MESSAGES=40
